<Page x:Class="Project_FREAK.Views.Settings.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="#1E1E1E">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Configure hardware connections, data review, and sensor calibration in one place." Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <GroupBox Header="LabJack connection and live sensors">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Reconnect" Padding="14,5" Click="ReconnectButton_Click"/>
                            <TextBlock x:Name="DeviceStatusText" Text="Checking LabJack…" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="If no LabJack is detected, simulated sensor readings are used automatically. The live values show each sensor's input voltage and the corresponding converted load or pressure." Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Load-cell signal:" FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock x:Name="LoadCellLiveText" Grid.Row="0" Grid.Column="1" Text="Waiting for sensor readings…" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Pressure signal:" FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock x:Name="PressureLiveText" Grid.Row="1" Grid.Column="1" Text="Waiting for sensor readings…" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Hardware channel assignments">
                    <StackPanel>
                        <TextBlock Text="AIN channels read analog sensor voltages; choose the channel physically wired to each sensor. Choose the DAC wired to the igniter output. AIN6 is reserved for automatic load-cell excitation-voltage feedback, and the pressure and load-cell signals must use different AIN channels." Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Pressure sensor input (AIN):" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox x:Name="PressureInputChannelComboBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Load-cell input (AIN):" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox x:Name="LoadCellInputChannelComboBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Igniter output (DAC):" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox x:Name="IgniterOutputChannelComboBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Review data source">
                    <StackPanel>
                        <CheckBox x:Name="UseRawDataForReviewCheckBox" Content="Recalculate review data from raw sensor voltages" IsChecked="{Binding UseRawDataForReview}" Foreground="White" FontSize="15"/>
                        <TextBlock Text="When enabled, review recalculates thrust and pressure from the raw voltages stored in the recording, using the currently applied calibration. When disabled, it uses the engineering-unit values already stored in the JSON file. Applying or saving this option refreshes the open review." Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Sensor calibration" FontSize="22" FontWeight="Bold" Margin="0,4,0,8"/>
                <TextBlock Text="Use two distinct known loads applied steadily along the load cell's sensing axis. Enter their masses in kg and capture each while the load is settled; captured samples include both the bridge signal and excitation voltage. Raw bridge output varies with excitation, so the app reads excitation feedback on AIN6. Pressure scaling uses the sensor's zero and full-scale output voltages and rated pressure." Foreground="#BDBDBD" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="SimulationNoticeText" Text="SIMULATION: no LabJack is detected. Live values are simulated and must not be used to calibrate hardware." Foreground="Orange" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

                <GroupBox Header="Load cell — two-point system calibration">
                    <StackPanel>
                        <TextBlock Text="Each captured point pairs a known mass with the measured bridge signal and excitation voltage. The two points determine the load-cell scale and zero offset. Use masses or equivalent reference forces that load the cell in the same direction and setup as the motor test; a no-load point is valid if the other point applies a different known load." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="CalibrationLoadCellLiveText" Text="Waiting for live load-cell readings…" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="1. Enter the first known mass, apply it to the cell, let the reading settle, then capture." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Known mass (kg):" VerticalAlignment="Center" Width="125"/>
                                    <TextBox x:Name="Point1WeightTextBox" Width="100"/>
                                </StackPanel>
                                <Button Content="Capture first load" Width="150" HorizontalAlignment="Left" Click="CapturePoint1_Click"/>
                                <TextBlock x:Name="Point1SampleText" Text="No sample captured." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="2. Change to a different known mass, let the reading settle, then capture again." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Known mass (kg):" VerticalAlignment="Center" Width="125"/>
                                    <TextBox x:Name="Point2WeightTextBox" Width="100"/>
                                </StackPanel>
                                <Button Content="Capture second load" Width="150" HorizontalAlignment="Left" Click="CapturePoint2_Click"/>
                                <TextBlock x:Name="Point2SampleText" Text="No sample captured." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Calculate calibration" Padding="10,5" Click="CalculateLoadCellCalibration_Click"/>
                            <TextBlock x:Name="LoadCellCalibrationStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="LoadCellResultText" Text="Current calibrated load: —" FontSize="18" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pressure sensor — linear voltage scaling">
                    <StackPanel>
                        <TextBlock Text="Enter the sensor output voltage at zero pressure, its output voltage at full-scale pressure, and the pressure value at that full-scale point. The app linearly maps between those endpoints. Use the sensor datasheet or known pressure references; the defaults map 0.5–4.5 V to 0–1600 PSI." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Zero-pressure voltage (V):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="PressureZeroVoltageTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" TextChanged="PressureScale_TextChanged"/>
                            <TextBlock Grid.Row="1" Text="Full-scale voltage (V):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="PressureFullScaleVoltageTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" TextChanged="PressureScale_TextChanged"/>
                            <TextBlock Grid.Row="2" Text="Full-scale pressure (PSI):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="PressureFullScaleValueTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" TextChanged="PressureScale_TextChanged"/>
                        </Grid>
                        <TextBlock x:Name="PressureCalibrationLiveText" Text="Current pressure: —" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="PressureValidationText" Foreground="OrangeRed" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#2D2D30" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Apply uses the settings for this session. Save also stores them for future sessions." Foreground="#BDBDBD" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#BDBDBD"/>
                    <Button Content="Apply" Width="100" Height="32" Margin="0,0,10,0" Click="ApplyButton_Click"/>
                    <Button Content="Save" Width="100" Height="32" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
