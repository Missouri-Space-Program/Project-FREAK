<Page x:Class="Project_FREAK.Views.ReviewDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
      Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Open Data JSON" Padding="12,7" Click="OpenJsonButton_Click"/>
                <Button Content="Choose Video" Padding="12,7" Margin="8,0,0,0" Click="OpenVideoButton_Click"/>
                <Button x:Name="ExportEngButton" Content="Export .eng" Padding="12,7" Margin="8,0,0,0" IsEnabled="False" Click="ExportEngButton_Click" ToolTip="Export test data in RASP / RockSim .eng format over the selected interval"/>
            </StackPanel>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ReviewStatusText" Text="Choose a saved test JSON file to begin." Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="ConversionNoticeText" Foreground="#9FE3A2" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScottPlot:WpfPlot x:Name="ThrustPlot" Grid.Row="0" MinHeight="220"
                                   PreviewMouseLeftButtonDown="Plot_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="Plot_PreviewMouseMove"
                                   PreviewMouseLeftButtonUp="Plot_PreviewMouseLeftButtonUp"/>
                <Grid Grid.Row="1" MinHeight="220">
                    <ScottPlot:WpfPlot x:Name="PressurePlot"
                                       PreviewMouseLeftButtonDown="Plot_PreviewMouseLeftButtonDown"
                                       PreviewMouseMove="Plot_PreviewMouseMove"
                                       PreviewMouseLeftButtonUp="Plot_PreviewMouseLeftButtonUp"/>
                </Grid>
                <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="14" Padding="8,5" Background="#B5222222" CornerRadius="4" IsHitTestVisible="False">
                    <TextBlock Text="Drag the green START and red END lines on either graph to select an interval."
                               Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="#252525" Padding="10" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="VideoPlayer" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="PlayPauseButton" Content="Play" Width="90" Click="PlayPauseButton_Click"/>
                        <TextBlock x:Name="VideoStatusText" Text="No video loaded." Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Slider x:Name="VideoSeekSlider" Grid.Row="2" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="VideoSeekSlider_ValueChanged"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OverallStatsText" Grid.Column="0" Foreground="White" TextWrapping="Wrap" Margin="4"/>
            <TextBlock x:Name="IntervalStatsText" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="4"/>
        </Grid>
    </Grid>
</Page>
