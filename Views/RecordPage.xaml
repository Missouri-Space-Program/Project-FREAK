<Page x:Class="Project_FREAK.Views.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
      Background="#1E1E1E">

    <Page.Resources>
        <Style x:Key="ControlPanelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Left Side: Graphs (now spans both rows) -->
        <Grid Grid.Column="0" Grid.RowSpan="2" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="#252525" 
                    CornerRadius="10" 
                    Margin="2"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
                <ScottPlot:WpfPlot x:Name="ThrustGraph" />

            </Border>

            <Border Grid.Row="1" 
                    Background="#252525" 
                    CornerRadius="10" 
                    Margin="2"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
                <ScottPlot:WpfPlot x:Name="PressureGraph"/>
            </Border>
        </Grid>


        <!-- Right Side: Video Playback -->
        <Border Grid.Column="1" 
        Grid.Row="0" 
        Background="Black" 
        CornerRadius="10" 
        Margin="2"
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Stretch">
            <Grid>
                <!-- The webcam feed will be loaded into this Image -->
                <Image x:Name="WebcamImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <!-- This TextBlock overlays the Image until the webcam feed is ready -->
                <TextBlock x:Name="LoadingTextBlock"
                   Text="Loading."
                   Foreground="White"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Background="Transparent"/>
            </Grid>
        </Border>


        <!-- Right Side: Control Panel -->
        <Border Grid.Column="1" 
                Grid.Row="1" 
                Background="#333" 
                CornerRadius="10" 
                Margin="2"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ControlPanelTitle" Text="Control Panel" 
                           FontSize="20"
                           Foreground="White" 
                           TextAlignment="Center" 
                           Margin="0,0,0,8"/>

                <!-- Button Grid -->
                <Grid Grid.Row="1" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buttons with scaling text -->
                    <Button x:Name="StartButton" Grid.Column="0" 
                            Style="{StaticResource ControlPanelButtonStyle}"
                            Background="DarkGray" 
                            Margin="4,4,6,4"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Click="StartTestButton_Click">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <TextBlock x:Name="StartTestTextBlock" Text="Start" Foreground="White" Margin="2" TextDecorations="Strikethrough"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="ArmButton" Grid.Column="1" 
                            Style="{StaticResource ControlPanelButtonStyle}"
                            Background="Green" 
                            Margin="6,4,4,4"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Click="ArmButton_Click">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <TextBlock x:Name="ArmTextBlock" Text="Arm" Foreground="White" Margin="2"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
