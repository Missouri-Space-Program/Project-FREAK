<Page x:Class="Project_FREAK.Views.ModeSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E1E">
    <Grid>
        <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Project FREAK" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Choose what you would like to do." Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,30"/>
            <Button Content="Record a Test" Height="64" FontSize="22" Margin="0,0,0,14" Click="RecordButton_Click"/>
            <Button Content="Review Recorded Data" Height="64" FontSize="22" Click="ReviewButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
