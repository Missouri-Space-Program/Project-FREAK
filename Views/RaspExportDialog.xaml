<Window x:Class="Project_FREAK.Views.RaspExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export RASP Motor Data (.eng)"
        Width="640" Height="780"
        MinHeight="600" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Export RASP / RockSim Motor (.eng)" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Configure motor casing dimensions, propellant weights, and test interval for simulator export."
                       Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Scrollable Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Interval Selection -->
                <GroupBox Header="Burn Interval &amp; Resolution">
                    <StackPanel>
                        <TextBlock Text="Specify the interval spanning the motor burn. Data points will be normalized starting at t = 0."
                                   Foreground="#B0B0B0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start (s):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="IntervalStartTextBox" Grid.Column="1" Margin="0,0,12,0" TextChanged="IntervalInputs_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="End (s):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="IntervalEndTextBox" Grid.Column="3" TextChanged="IntervalInputs_TextChanged"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="UseGraphIntervalButton" Content="Use Graph Selection" Padding="8,4" Margin="0,0,8,0" Click="UseGraphIntervalButton_Click"/>
                            <Button x:Name="UseFullRecordingButton" Content="Use Full Recording" Padding="8,4" Click="UseFullRecordingButton_Click"/>
                        </StackPanel>

                        <!-- Live Interval Statistics -->
                        <Border Background="#252528" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                            <TextBlock x:Name="IntervalStatsTextBlock" Text="Calculating interval stats…" Foreground="#9FE3A2" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Data points:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ResolutionComboBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Standard (up to 500 points — recommended)" Tag="500"/>
                                <ComboBoxItem Content="Compact (up to 100 points)" Tag="100"/>
                                <ComboBoxItem Content="Classic RASP (max 32 points)" Tag="32"/>
                                <ComboBoxItem Content="Full resolution (all recorded samples)" Tag="all"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Motor Identification -->
                <GroupBox Header="Motor Identification">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Motor Name / Designation:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="MotorNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Manufacturer Code:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="ManufacturerTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Delays:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox x:Name="DelaysTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4"
                                 ToolTip="Available delays (e.g. 'P' for plugged/static test, '0' for none, or '4-8-12')"/>
                    </Grid>
                </GroupBox>

                <!-- Casing & Physical Specifications -->
                <GroupBox Header="Casing &amp; Physical Specifications (Unknown to App)">
                    <StackPanel>
                        <TextBlock Text="Casing dimensions and masses cannot be measured by the test stand. Enter your motor specs below."
                                   Foreground="#B0B0B0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Casing Diameter (mm):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="DiameterTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Casing Length (mm):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="LengthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Propellant Mass (kg):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="PropellantWeightTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4"
                                     ToolTip="Total consumable / propellant weight in kilograms (e.g. 50g = 0.050)"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Motor Mass (kg):" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TotalWeightTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                                     ToolTip="Total loaded motor weight ready for flight in kilograms (e.g. 100g = 0.100)"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Notes / Comments -->
                <GroupBox Header="Optional Notes / Description">
                    <TextBox x:Name="CommentsTextBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,2"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Validation Error Panel -->
        <Border Grid.Row="2" x:Name="ErrorBorder" Background="#3B1818" BorderBrush="#E74C3C" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,6,0,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorTextBlock" Foreground="#FF8585" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="3" Margin="0,4,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,7" DockPanel.Dock="Left" Click="CancelButton_Click"/>
            <Button x:Name="ExportButton" Content="Export .eng…" IsDefault="True" Padding="20,7" DockPanel.Dock="Right"
                    Background="#007ACC" BorderBrush="#005A9E" FontWeight="SemiBold" Click="ExportButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
